# Shortify environment example.
#
# Local Go run:
#   1. Copy this file to server/.env
#   2. Replace JWT_SECRET with your own long random value
#   3. Run from server/: go run ./cmd/api
#
# Docker Compose:
#   docker-compose.yml already contains local Docker values.
#   Use this file as a reference when you move secrets to real env vars.

# REST API port.
# Local URL: http://localhost:8080
HTTP_PORT=8080

# gRPC API port.
# Local address: localhost:9090
GRPC_PORT=9090

# PostgreSQL connection string.
#
# Local run from host machine:
DATABASE_URL=postgres://shortify:shortify@localhost:15432/shortify?sslmode=disable
#
# Docker Compose value, if backend runs inside Docker:
# DATABASE_URL=postgres://shortify:shortify@postgres:5432/shortify?sslmode=disable
#
# Production example, usually with sslmode=require:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require

# JWT signing secret.
# Do not commit a real value.
# Generate a long random string and put it in server/.env or hosting env vars.
JWT_SECRET=replace-with-long-random-secret

# Public base URL used to build short links.
# Local:
BASE_URL=http://localhost:8080
#
# Production example:
# BASE_URL=https://your-api-domain.com
