# Backend environment example.
#
# Local Go run:
#   1. Copy this file to .env in this same server/ folder
#   2. Replace JWT_SECRET with your own long random value
#   3. Run: go run ./cmd/api

# REST API port.
HTTP_PORT=8080

# gRPC API port.
GRPC_PORT=9090

# PostgreSQL connection string for local host machine.
# Use this when Postgres is exposed on localhost:15432 (see docker-compose.yml).
DATABASE_URL=postgres://shortify:shortify@localhost:15432/shortify?sslmode=disable

# If backend runs inside Docker Compose, use this instead:
# DATABASE_URL=postgres://shortify:shortify@postgres:5432/shortify?sslmode=disable

# JWT signing secret.
# Do not commit a real value. Put the real value in server/.env or hosting env vars.
JWT_SECRET=replace-with-long-random-secret

# Public backend URL used to build short links.
BASE_URL=http://localhost:8080
